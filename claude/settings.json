{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(curl:)",
      "Bash(wget:)",
      "Bash(sudo:)",
      "Read(.env)",
      "Read(.env.)",
      "Read(/.ssh/)",
      "Read(/.secret/)"
    ],
    "ask": [
      "Bash(git push:)",
      "Bash(rm:)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true
}
