{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(curl:)",
      "Bash(wget:)",
      "Bash(sudo:)",
      "Read(.env)",
      "Read(.env.)",
      "Read(/.ssh/)",
      "Read(/.secret/)"
    ],
    "ask": [
      "Bash(git push:)",
      "Bash(rm:)"
    ]
  }
}

